{
  "name": "gate_transition",
  "description": "Validate a SPHINX gate transition (KENL→AWI→ATOM→SAIF→Safe Spiral).",
  "inputSchema": {
    "type": "object",
    "properties": {
      "gate": {
        "type": "string",
        "enum": [
          "knowledge_to_intention",
          "intention_to_execution",
          "execution_to_learning",
          "learning_to_regeneration"
        ],
        "description": "Gate to validate"
      },
      "context": {
        "type": "object",
        "additionalProperties": {},
        "description": "Gate context (requirements vary by gate)"
      }
    },
    "required": [
      "gate",
      "context"
    ],
    "additionalProperties": false,
    "$schema": "http://json-schema.org/draft-07/schema#"
  }
}