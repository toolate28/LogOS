{
  "name": "store_context",
  "description": "Store explicitly declared cross-platform context only when operator knowledge is present; α/ω fields and freeform metadata are not accepted here.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "key": {
        "type": "string",
        "description": "Unique context key"
      },
      "content": {
        "type": "string",
        "description": "Context content to store"
      },
      "platform": {
        "type": "string",
        "enum": [
          "claude",
          "grok",
          "gemini",
          "llama",
          "human",
          "generic"
        ],
        "description": "Source platform"
      },
      "operator_notice": {
        "type": "string",
        "minLength": 1,
        "description": "Explicit notice that the subject or operator already knows this context is being stored."
      }
    },
    "required": [
      "key",
      "content",
      "platform",
      "operator_notice"
    ],
    "additionalProperties": false,
    "$schema": "http://json-schema.org/draft-07/schema#"
  }
}