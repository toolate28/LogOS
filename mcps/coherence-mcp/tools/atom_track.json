{
  "name": "atom_track",
  "description": "Track a decision in the ATOM trail (Atomic Task Orchestration Method).",
  "inputSchema": {
    "type": "object",
    "properties": {
      "decision": {
        "type": "string",
        "description": "Decision description"
      },
      "files": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "Related files"
      },
      "tags": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "Tags for categorization"
      },
      "type": {
        "type": "string",
        "default": "DOC",
        "description": "Decision type (DOC, VERIFY, BUILD, DEPLOY)"
      }
    },
    "required": [
      "decision",
      "files",
      "tags"
    ],
    "additionalProperties": false,
    "$schema": "http://json-schema.org/draft-07/schema#"
  }
}