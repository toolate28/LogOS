{
  "mcpServers": {
    "coherence-mcp": {
      "command": "coherence-mcp",
      "args": [],
      "env": {
        "LOGOS_ROOT": "${LOGOS_ROOT}",
        "COHERENCE_MCP_ROOT": "${COHERENCE_MCP_ROOT}",
        "RESON8_LOGOS_ROOT": "${LOGOS_ROOT}",
        "CTWFI_INVARIANT": "alpha+omega=15",
        "CTWFI_STRAND": "reason"
      },
      "x-privacy": {
        "network": "none",
        "data_scope": "repository",
        "telemetry": "none"
      }
    }
  }
}
