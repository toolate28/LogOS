{
  "$comment": "MCP Inspector config for coherence-mcp. Machine-local values scrubbed per privacy stack (docs/security/PRIVACY-STACK.md) — fill from your own environment; never commit real user paths.",
  "mcpServers": {
    "coherence-mcp": {
      "command": "coherence-mcp",
      "args": [],
      "env": {
        "LOGOS_ROOT": "${LOGOS_ROOT}",
        "ATOM_TRAIL_ROOT": "${LOGOS_ROOT}/.atom-trail",
        "SPIRALSAFE_PATH": "${SPIRALSAFE_ROOT}",
        "APPDATA": "${APPDATA}",
        "HOMEDRIVE": "${HOMEDRIVE}",
        "HOMEPATH": "${HOMEPATH}",
        "LOCALAPPDATA": "${LOCALAPPDATA}",
        "USERNAME": "${USERNAME}",
        "USERPROFILE": "${USERPROFILE}",
        "TEMP": "${TEMP}",
        "SYSTEMROOT": "C:\\WINDOWS",
        "SYSTEMDRIVE": "C:",
        "PROCESSOR_ARCHITECTURE": "AMD64",
        "PROGRAMFILES": "C:\\Program Files",
        "PATH": "${PATH}"
      },
      "x-privacy": {
        "network": "none",
        "data_scope": "repository",
        "telemetry": "none"
      }
    }
  }
}
